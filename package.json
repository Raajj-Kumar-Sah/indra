{
  "name": "indira-industries-saas",
  "version": "1.0.0",
  "description": "React and Express B2B commerce platform for Indira Industries powered by Supabase",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon src/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "seed": "node src/scripts/seed.js"
  },
  "keywords": [
    "indira-industries",
    "b2b",
    "saas",
    "supabase",
    "ecommerce",
    "lubricants"
  ],
  "author": "Indira Industries",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.4",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
